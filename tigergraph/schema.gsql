// ==============================================================================
// TigerGraph Fraud Investigation Knowledge Graph Schema
// Hacker House Goa (HHGOA) IEEE-CIS Edition
// ==============================================================================

CREATE GRAPH FraudInvestigationGraph ()

// ------------------------------------------------------------------------------
// Vertex Definitions
// ------------------------------------------------------------------------------

// Customer vertex representing the account holder
CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING,
    created_at STRING,
    risk_tier STRING DEFAULT "standard"
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Card vertex representing credit or debit cards held by customers
CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card1 STRING,
    card2 STRING,
    card3 STRING,
    card4 STRING,      // visa, mastercard, american express, discover
    card5 STRING,
    card6 STRING,      // credit, debit
    status STRING DEFAULT "active" // active, blocked, monitored
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Transaction vertex representing financial transactions
CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    ts STRING,                 // YYYY-MM-DD HH:MM:SS
    amount DOUBLE,             // TransactionAmt in USD
    channel STRING,            // in_person (ProductCD 'W') or online
    product_cd STRING,         // W, C, H, R, S
    risk_score DOUBLE,         // Model score [0.0 - 1.0]
    dist1 DOUBLE,
    dist2 DOUBLE,
    is_flagged BOOL DEFAULT FALSE
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// DeviceProfile representing digital identity fingerprint
// Composite key: DeviceInfo | OS | Browser | Screen
CREATE VERTEX DeviceProfile (
    PRIMARY_ID profile_id STRING,
    device_info STRING,        // DeviceInfo e.g. SAMSUNG SM-G935F
    device_type STRING,        // mobile, desktop
    os STRING,                 // id_30 e.g. Android 7.0, iOS 11.1.2, Windows 10
    browser STRING,            // id_31 e.g. chrome 62.0, mobile safari 11.0
    screen STRING,             // id_33 e.g. 1920x1080, 2220x1080
    proxy_status STRING,       // id_23 e.g. transparent, anonymous, hidden
    device_status STRING       // id_15 e.g. New, Found
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// EmailDomain vertex representing email domains
CREATE VERTEX EmailDomain (
    PRIMARY_ID domain_name STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// BillingRegion representing geographical or postal billing zones (addr1)
CREATE VERTEX BillingRegion (
    PRIMARY_ID region_code STRING,
    country_code STRING DEFAULT "87" // addr2, 87 is home country
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// ClosedCase representing historical investigations (case memory)
CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at STRING,
    closed_at STRING,
    outcome STRING,            // confirmed_fraud, cleared
    pattern STRING,            // card_testing, card_not_present_fraud, etc.
    exposure_usd DOUBLE,
    actions_taken STRING,
    report_filed STRING,       // Yes, No
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// FraudCase representing new agent-generated cases (dynamic graph memory)
CREATE VERTEX FraudCase (
    PRIMARY_ID case_id STRING,
    status STRING,             // open, closed_fraud, closed_legitimate, escalated
    verdict STRING,            // fraud, legitimate, uncertain
    fraud_probability DOUBLE,
    pattern STRING,
    pattern_description STRING,
    exposure_usd DOUBLE,
    summary STRING,
    opened_at STRING,
    closed_at STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// ------------------------------------------------------------------------------
// Edge Definitions
// ------------------------------------------------------------------------------

// Customer owns Card (directed)
CREATE DIRECTED EDGE OWNS (
    FROM Customer, TO Card
) WITH REVERSE_EDGE="OWNED_BY";

// Card made Transaction (directed)
CREATE DIRECTED EDGE MADE (
    FROM Card, TO Transaction
) WITH REVERSE_EDGE="MADE_BY";

// Transaction originated from DeviceProfile (directed)
CREATE DIRECTED EDGE FROM_DEVICE (
    FROM Transaction, TO DeviceProfile
) WITH REVERSE_EDGE="DEVICE_OF_TXN";

// Transaction associated with purchaser email domain
CREATE DIRECTED EDGE PURCHASER_EMAIL (
    FROM Transaction, TO EmailDomain
) WITH REVERSE_EDGE="EMAIL_OF_TXN";

// Transaction billed in BillingRegion
CREATE DIRECTED EDGE BILLED_IN (
    FROM Transaction, TO BillingRegion
) WITH REVERSE_EDGE="REGION_OF_TXN";

// Temporal chain between sequential transactions on the same card
CREATE DIRECTED EDGE NEXT (
    FROM Transaction, TO Transaction,
    time_delta_sec INT
);

// Case relationships to entities for memory and graph investigation
CREATE DIRECTED EDGE INVOLVES (
    FROM ClosedCase, TO Transaction | FROM FraudCase, TO Transaction
) WITH REVERSE_EDGE="INVOLVED_IN_CASE";

CREATE DIRECTED EDGE ON_CARD (
    FROM ClosedCase, TO Card | FROM FraudCase, TO Card
) WITH REVERSE_EDGE="HAS_CASE";

CREATE DIRECTED EDGE CONNECTED_TO (
    FROM ClosedCase, TO Card | FROM FraudCase, TO Card
) WITH REVERSE_EDGE="CONNECTED_CASE";
